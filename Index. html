<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
<title>FarmConnect Africa</title>
<meta name="theme-color" content="#1F4D2C" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="mobile-web-app-capable" content="yes" />
<link rel="manifest" href="manifest.json" />

<script>
  window.FIREBASE_CONFIG = {
    apiKey: "AIzaSyDqUFEJKoAjC2-2YKEpYNezhN1m8x-hKuo",
    authDomain: "farmconnect-africa-fc147.firebaseapp.com",
    projectId: "farmconnect-africa-fc147",
    storageBucket: "farmconnect-africa-fc147.firebasestorage.app",
    messagingSenderId: "499528873132",
    appId: "1:499528873132:web:0444674f4c6bee09d19b09"
  };
</script>

<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-firestore-compat.js"></script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap');
  * { box-sizing: border-box; }
  body { margin: 0; font-family: 'Inter', sans-serif; background: #EEEAD9; color: #1C2318; }
  .ff-display { font-family: 'Fraunces', serif; }
  input, button { font-family: inherit; }
  a { text-decoration: none; }
  ::-webkit-scrollbar { width: 0; height: 0; }

  #app { max-width: 480px; margin: 0 auto; min-height: 100vh; background: #F3F1E7; display: flex; flex-direction: column; }
  .topbar { background: #1F4D2C; color: #fff; padding: 16px 18px 13px; display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .topbar .title { font-size: 18px; font-weight: 600; }
  .screen { flex: 1; overflow-y: auto; }
  .navbar { display: flex; border-top: 1px solid #E1DCC8; background: #fff; padding: 8px 0; flex-shrink: 0; }
  .navbtn { flex: 1; background: none; border: none; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 4px 0; }
  .navbtn .icon { font-size: 17px; opacity: 0.5; }
  .navbtn.active .icon { opacity: 1; }
  .navbtn .label { font-size: 10.5px; color: #66705F; font-weight: 500; }
  .navbtn.active .label { color: #1F4D2C; font-weight: 700; }

  .card { background: #fff; border: 1px solid #E1DCC8; border-radius: 14px; padding: 13px; margin-bottom: 10px; }
  .quickbtn { width: 100%; background: #fff; border: 1px solid #E1DCC8; border-radius: 14px; padding: 13px 14px; display: flex; align-items: center; margin-bottom: 9px; cursor: pointer; text-align: left; font-size: 13.5px; font-weight: 600; color: #1C2318; }
  .weatherbanner { margin-top: 16px; background: #3E7C8C; border-radius: 16px; padding: 16px; color: #fff; }
  input.field { width: 100%; padding: 10px 12px; border-radius: 12px; border: 1px solid #E1DCC8; font-size: 13px; margin-bottom: 9px; box-sizing: border-box; }
  .fab { position: fixed; right: 18px; bottom: 82px; background: #D98E2B; color: #fff; border: none; border-radius: 30px; padding: 12px 18px; font-weight: 700; font-size: 13px; cursor: pointer; box-shadow: 0 8px 18px rgba(217,142,43,0.4); }
  .modal-bg { position: fixed; inset: 0; background: rgba(0,0,0,0.45); display: flex; align-items: flex-end; z-index: 10; max-width: 480px; margin: 0 auto; }
  .modal { background: #fff; width: 100%; border-radius: 20px 20px 0 0; padding: 20px; }
  .bubble { max-width: 80%; padding: 10px 13px; border-radius: 14px; font-size: 13px; line-height: 1.5; margin-bottom: 10px; }
  .bubble.user { background: #1F4D2C; color: #fff; margin-left: auto; }
  .bubble.bot { background: #fff; border: 1px solid #E1DCC8; }
  .contactbar { margin: 0 14px 10px; background: #D9EBEE; border-radius: 12px; padding: 10px 12px; display: flex; align-items: center; gap: 10px; }
  .circlebtn { width: 30px; height: 30px; border-radius: 50%; background: #3E7C8C; display: flex; align-items: center; justify-content: center; color: #fff; flex-shrink: 0; }
  .pill { padding: 7px 14px; border-radius: 20px; font-size: 12.5px; font-weight: 600; cursor: pointer; border: 1px solid #E1DCC8; background: #fff; color: #66705F; margin-right: 8px; }
  .pill.active { border-color: #1F4D2C; background: #1F4D2C; color: #fff; }
</style>
</head>
<body>
<div id="app"></div>

<script>
// ---------- Firebase ----------
let db = null;
let firebaseReady = false;
try {
  firebase.initializeApp(window.FIREBASE_CONFIG);
  db = firebase.firestore();
  firebaseReady = true;
} catch (e) {
  console.error("Firebase not configured yet:", e);
}

// ---------- Data ----------
const agronomist = {
  name: "Mr. M Gandiya",
  title: "Lead Agronomist, FarmConnect Africa",
  phone: "+263 785056260",
  email: "agronomist@farmconnectafrica.co.zw"
};

const consultants = [
  { name: "Dr. T. Moyo", specialty: "Soil & Fertility", rate: "$15 / session" },
  { name: "S. Chikwanha", specialty: "Livestock & Poultry", rate: "$10 / session" },
  { name: "P. Ndlovu", specialty: "Irrigation Systems", rate: "$18 / session" }
];

const cropCalendar = {
  Maize: [
    { stage: "Land prep", window: "Sep - Oct" },
    { stage: "Planting", window: "Nov - Dec" },
    { stage: "Weeding & top dress", window: "Jan" },
    { stage: "Harvest", window: "Apr - May" }
  ],
  Tomatoes: [
    { stage: "Nursery", window: "Jul - Aug" },
    { stage: "Transplant", window: "Sep" },
    { stage: "Flowering & feeding", window: "Oct - Nov" },
    { stage: "Harvest", window: "Dec - Jan" }
  ]
};

const FAQ = [
  { keys: ["tomato"], a: "Tomatoes do best with well-drained soil and consistent watering. Watch for blight in wet weather - remove affected leaves early and ask your agronomist about a suitable fungicide." },
  { keys: ["maize", "corn"], a: "Maize is usually planted Nov-Dec in Zimbabwe with the first rains. Top-dress with fertilizer about 4-6 weeks after planting, once the plant has 6-8 leaves." },
  { keys: ["pest", "insect", "worm"], a: "For pest issues, identify the pest first if you can (photo helps). Rotate crops and remove affected plants promptly. For chemical treatment amounts, please contact our agronomist directly." },
  { keys: ["price", "market"], a: "Check the Marketplace tab for current listings and prices near you. Prices vary by season and region." },
  { keys: ["water", "irrigation"], a: "Water early morning or late afternoon to reduce evaporation loss. Drip irrigation saves the most water if you can invest in it." },
  { keys: ["soil", "fertilizer", "fertiliser"], a: "A simple soil test tells you what your soil is missing before you buy fertilizer - this saves money and improves yield." }
];

function askFAQ(q) {
  const lower = q.toLowerCase();
  const hit = FAQ.find(f => f.keys.some(k => lower.includes(k)));
  return hit ? hit.a : "I don't have a specific answer for that yet - please contact our agronomist directly using the button below.";
}

// ---------- State ----------
let screen = "home";
let listings = [];
let chatMessages = [{ role: "bot", content: "Hi! Ask me about crops, pests, soil, or watering." }];
let booked = null;
let selectedCrop = "Maize";

const titles = { home: "FarmConnect Africa", market: "Marketplace", bot: "Ask FCA", book: "Consultants", profile: "Profile" };

function setScreen(s) { screen = s; render(); }

// ---------- Firestore listings ----------
function loadListings() {
  if (!firebaseReady) {
    listings = [
      { id: "demo1", crop: "Tomatoes", farmer: "Tendai Moyo", location: "Mutare", qty: "200 kg", price: "$0.80/kg" },
      { id: "demo2", crop: "Maize", farmer: "Chipo Ncube", location: "Gweru", qty: "1.5 tonnes", price: "$320/tonne" }
    ];
    render();
    return;
  }
  db.collection("listings").orderBy("createdAt", "desc").limit(50).onSnapshot(function(snap) {
    listings = snap.docs.map(function(d) { return Object.assign({ id: d.id }, d.data()); });
    if (screen === "market") render();
  }, function(err) { console.error(err); });
}

function addListing(form) {
  if (!form.crop || !form.qty || !form.price) return;
  if (firebaseReady) {
    db.collection("listings").add(Object.assign({}, form, {
      farmer: form.farmer || "Anonymous farmer",
      createdAt: firebase.firestore.FieldValue.serverTimestamp()
    })).then(function() {
      document.getElementById("marketModalBg").remove();
    }).catch(function(e) { alert("Couldn't save listing: " + e.message); });
  } else {
    listings.unshift(Object.assign({ id: "local" + Date.now() }, form, { farmer: form.farmer || "You" }));
    document.getElementById("marketModalBg").remove();
    render();
  }
}

function esc(s) {
  return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

// ---------- Screens ----------
function renderHome() {
  return (
    '<div class="screen" style="padding:18px 18px 24px">' +
      '<div class="ff-display" style="font-size:21px;font-weight:600">Welcome back</div>' +
      '<div style="color:#66705F;font-size:13.5px;margin-top:4px">Here is what is happening today.</div>' +
      '<div class="weatherbanner"><div style="font-weight:700;font-size:14px">Light rain expected this week</div>' +
      '<div style="font-size:12px;opacity:0.9;margin-top:2px">Good conditions for planting</div></div>' +
      '<div class="ff-display" style="font-size:15px;font-weight:600;margin-top:22px;margin-bottom:10px">Quick actions</div>' +
      '<button class="quickbtn" data-nav="market">List produce for sale</button>' +
      '<button class="quickbtn" data-nav="bot">Ask a farming question</button>' +
      '<button class="quickbtn" data-nav="book">Book a consultant</button>' +
      (!firebaseReady ? '<div style="margin-top:20px;background:#F6E3C2;border-radius:12px;padding:12px;font-size:11.5px;color:#6B4226">Demo mode: listings will not be saved permanently.</div>' : '') +
    '</div>'
  );
}

function renderMarket() {
  const rows = listings.map(function(l) {
    return (
      '<div class="card"><div style="display:flex;justify-content:space-between">' +
      '<div class="ff-display" style="font-size:15.5px;font-weight:600">' + esc(l.crop) + '</div>' +
      '<div style="font-size:13.5px;font-weight:700;color:#1F4D2C">' + esc(l.price) + '</div></div>' +
      '<div style="font-size:12px;color:#66705F;margin-top:3px">' + esc(l.farmer) + ' &middot; ' + esc(l.qty) + '</div>' +
      '<div style="font-size:11.5px;color:#66705F;margin-top:4px">Location: ' + esc(l.location) + '</div></div>'
    );
  }).join("");
  return (
    '<div class="screen" style="display:flex;flex-direction:column;position:relative">' +
      '<div style="padding:14px 18px 10px"><input class="field" id="marketSearch" placeholder="Search crop or location" /></div>' +
      '<div style="flex:1;overflow-y:auto;padding:0 18px 90px" id="marketList">' + (rows || '<div style="text-align:center;color:#66705F;font-size:13px;margin-top:30px">No listings yet.</div>') + '</div>' +
      '<button class="fab" id="openListingForm">+ List produce</button>' +
    '</div>'
  );
}

function renderModal() {
  return (
    '<div class="modal-bg" id="marketModalBg"><div class="modal">' +
    '<div style="display:flex;justify-content:space-between;margin-bottom:14px">' +
    '<div class="ff-display" style="font-size:17px;font-weight:600">New listing</div>' +
    '<button id="closeListingForm" style="background:none;border:none;cursor:pointer;font-size:16px">&times;</button></div>' +
    '<input class="field" id="f_farmer" placeholder="Your name" />' +
    '<input class="field" id="f_crop" placeholder="Crop" />' +
    '<input class="field" id="f_qty" placeholder="Quantity (e.g. 100kg)" />' +
    '<input class="field" id="f_price" placeholder="Price (e.g. $0.80/kg)" />' +
    '<input class="field" id="f_location" placeholder="Location" />' +
    '<button id="submitListing" style="width:100%;background:#1F4D2C;color:#fff;border:none;border-radius:12px;padding:12px;font-weight:700;font-size:13.5px;cursor:pointer">Publish listing</button>' +
    '</div></div>'
  );
}

function renderBot() {
  const bubbles = chatMessages.map(function(m) {
    return '<div class="bubble ' + (m.role === "user" ? "user" : "bot") + '">' + esc(m.content) + '</div>';
  }).join("");
  return (
    '<div class="screen" style="display:flex;flex-direction:column">' +
      '<div style="flex:1;overflow-y:auto;padding:16px" id="chatLog">' + bubbles + '</div>' +
      '<div class="contactbar"><div style="flex:1"><div style="font-size:11.5px;font-weight:700">Prefer to ask a person?</div>' +
      '<div style="font-size:10.5px;color:#66705F">' + esc(agronomist.name) + '</div></div>' +
      '<a class="circlebtn" href="tel:' + agronomist.phone.replace(/\s/g, "") + '">Call</a>' +
      '<a class="circlebtn" href="mailto:' + agronomist.email + '">Mail</a></div>' +
      '<div style="display:flex;gap:8px;padding:10px 14px 14px;border-top:1px solid #E1DCC8;background:#fff">' +
      '<input class="field" style="margin-bottom:0;border-radius:20px" id="chatInput" placeholder="Ask about crops, pests, soil..." />' +
      '<button id="chatSend" style="width:38px;height:38px;border-radius:50%;background:#1F4D2C;border:none;color:#fff;cursor:pointer;flex-shrink:0">Go</button>' +
      '</div>' +
    '</div>'
  );
}

function renderBook() {
  if (booked) {
    return (
      '<div class="screen" style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:30px;text-align:center">' +
      '<div style="font-size:40px">Done</div>' +
      '<div class="ff-display" style="font-size:18px;font-weight:600;margin-top:14px">Session booked</div>' +
      '<div style="font-size:13px;color:#66705F;margin-top:6px">' + esc(booked.name) + ' will contact you within 24 hours.</div>' +
      '<button id="bookAnother" style="margin-top:20px;background:#1F4D2C;color:#fff;border:none;border-radius:12px;padding:10px 20px;font-weight:700;cursor:pointer">Book another</button>' +
      '</div>'
    );
  }
  const rows = consultants.map(function(cs, i) {
    return (
      '<div class="card"><div class="ff-display" style="font-weight:600;font-size:15px">' + esc(cs.name) + '</div>' +
      '<div style="font-size:12px;color:#66705F;margin-top:2px">' + esc(cs.specialty) + '</div>' +
      '<div style="display:flex;justify-content:space-between;align-items:center;margin-top:12px">' +
      '<span style="font-size:13px;font-weight:700;color:#1F4D2C">' + esc(cs.rate) + '</span>' +
      '<button data-book="' + i + '" style="background:#DCE8D6;color:#1F4D2C;border:none;border-radius:10px;padding:7px 14px;font-size:12.5px;font-weight:700;cursor:pointer">Book session</button>' +
      '</div></div>'
    );
  }).join("");
  return (
    '<div class="screen" style="padding:16px 18px 24px">' +
      '<div class="contactbar" style="margin:0 0 16px"><div style="flex:1"><div style="font-size:12.5px;font-weight:700">' + esc(agronomist.name) + '</div>' +
      '<div style="font-size:11px;color:#66705F">Free, direct contact</div></div>' +
      '<a class="circlebtn" href="tel:' + agronomist.phone.replace(/\s/g, "") + '">Call</a>' +
      '<a class="circlebtn" href="mailto:' + agronomist.email + '">Mail</a></div>' +
      rows +
    '</div>'
  );
}

function renderProfile() {
  const pills = Object.keys(cropCalendar).map(function(name) {
    return '<button class="pill ' + (selectedCrop === name ? "active" : "") + '" data-crop="' + name + '">' + name + '</button>';
  }).join("");
  const rows = cropCalendar[selectedCrop].map(function(s, i, arr) {
    return '<div style="display:flex;justify-content:space-between;padding:10px 12px;' + (i < arr.length - 1 ? "border-bottom:1px solid #E1DCC8" : "") + '">' +
      '<span style="font-size:13px">' + esc(s.stage) + '</span>' +
      '<span style="font-size:12.5px;color:#66705F;font-weight:600">' + esc(s.window) + '</span></div>';
  }).join("");
  return (
    '<div class="screen" style="padding:18px">' +
      '<div class="ff-display" style="font-size:15px;font-weight:600;margin-bottom:10px">Crop calendar</div>' +
      '<div style="margin-bottom:12px">' + pills + '</div>' +
      '<div class="card" style="padding:4px">' + rows + '</div>' +
    '</div>'
  );
}

// ---------- Render ----------
function render() {
  const nav = ["home", "market", "bot", "book", "profile"].map(function(key) {
    const labels = { home: "Home", market: "Market", bot: "Ask", book: "Book", profile: "Profile" };
    return '<button class="navbtn ' + (screen === key ? "active" : "") + '" data-nav="' + key + '">' +
      '<span class="icon">&#9679;</span><span class="label">' + labels[key] + '</span></button>';
  }).join("");

  let body = "";
  if (screen === "home") body = renderHome();
  else if (screen === "market") body = renderMarket();
  else if (screen === "bot") body = renderBot();
  else if (screen === "book") body = renderBook();
  else if (screen === "profile") body = renderProfile();

  document.getElementById("app").innerHTML =
    '<div class="topbar"><span>FCA</span><span class="title">' + titles[screen] + '</span></div>' +
    body +
    '<div class="navbar">' + nav + '</div>';

  attachHandlers();
}

function attachHandlers() {
  document.querySelectorAll("[data-nav]").forEach(function(el) {
    el.addEventListener("click", function() { setScreen(el.getAttribute("data-nav")); });
  });

  if (screen === "market") {
    const searchEl = document.getElementById("marketSearch");
    if (searchEl) {
      searchEl.addEventListener("input", function() {
        const q = searchEl.value.toLowerCase();
        const filtered = listings.filter(function(l) {
          return (l.crop || "").toLowerCase().includes(q) || (l.location || "").toLowerCase().includes(q);
        });
        const listEl = document.getElementById("marketList");
        listEl.innerHTML = filtered.map(function(l) {
          return (
            '<div class="card"><div style="display:flex;justify-content:space-between">' +
            '<div class="ff-display" style="font-size:15.5px;font-weight:600">' + esc(l.crop) + '</div>' +
            '<div style="font-size:13.5px;font-weight:700;color:#1F4D2C">' + esc(l.price) + '</div></div>' +
            '<div style="font-size:12px;color:#66705F;margin-top:3px">' + esc(l.farmer) + ' &middot; ' + esc(l.qty) + '</div>' +
            '<div style="font-size:11.5px;color:#66705F;margin-top:4px">Location: ' + esc(l.location) + '</div></div>'
          );
        }).join("") || '<div style="text-align:center;color:#66705F;font-size:13px;margin-top:30px">No listings match.</div>';
      });
    }
    const openBtn = document.getElementById("openListingForm");
    if (openBtn) openBtn.addEventListener("click", function() {
      document.getElementById("app").insertAdjacentHTML("beforeend", renderModal());
      document.getElementById("closeListingForm").addEventListener("click", function() {
        document.getElementById("marketModalBg").remove();
      });
      document.getElementById("submitListing").addEventListener("click", function() {
        addListing({
          farmer: document.getElementById("f_farmer").value,
          crop: document.getElementById("f_crop").value,
          qty: document.getElementById("f_qty").value,
          price: document.getElementById("f_price").value,
          location: document.getElementById("f_location").value
        });
      });
    });
  }

  if (screen === "bot") {
    const input = document.getElementById("chatInput");
    const send = document.getElementById("chatSend");
    function doSend() {
      const text = input.value.trim();
      if (!text) return;
      chatMessages.push({ role: "user", content: text });
      chatMessages.push({ role: "bot", content: askFAQ(text) });
      render();
    }
    if (send) send.addEventListener("click", doSend);
    if (input) input.addEventListener("keydown", function(e) { if (e.key === "Enter") doSend(); });
    const log = document.getElementById("chatLog");
    if (log) log.scrollTop = log.scrollHeight;
  }

  if (screen === "book") {
    document.querySelectorAll("[data-book]").forEach(function(btn) {
      btn.addEventListener("click", function() {
        booked = consultants[parseInt(btn.getAttribute("data-book"), 10)];
        render();
      });
    });
    const again = document.getElementById("bookAnother");
    if (again) again.addEventListener("click", function() { booked = null; render(); });
  }

  if (screen === "profile") {
    document.querySelectorAll("[data-crop]").forEach(function(btn) {
      btn.addEventListener("click", function() { selectedCrop = btn.getAttribute("data-crop"); render(); });
    });
  }
}

render();
loadListings();

if ('serviceWorker' in navigator) {
  window.addEventListener('load', function() {
    navigator.serviceWorker.register('sw.js').catch(function() {});
  });
}
</script>
</body>
</html>
